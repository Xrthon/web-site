<div class="mx-auto w-full px-6">
  <div class="overflow-hidden rounded-3xl bg-white shadow-xl">

    <!-- HEADER -->
    <div class="bg-gradient-to-r from-gray-900 to-gray-700 px-8 py-10">
      <h1 class="text-3xl font-bold text-white">
        Statut de vérification
      </h1>

      <p class="mt-2 text-gray-300">
        Consultez l'état actuel de votre vérification d'identité.
      </p>
    </div>

    <div class="p-8">

      <% if alert = flash[:alert] %>
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
          <%= alert %>
        </div>
      <% end %>

      <% if notice = flash[:notice] %>
        <div class="mb-6 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700">
          <%= notice %>
        </div>
      <% end %>

      <% if @identity_verification.present? %>

        <!-- STATUS -->
        <div class="mb-8 rounded-2xl border border-gray-200 bg-gray-50 p-6">
          <p class="text-sm font-medium text-gray-500">
            Statut actuel
          </p>

          <p class="mt-2 text-2xl font-bold text-gray-900">
            <%= @identity_verification.identity_verification_status.translated_name %>
          </p>

          <% if @identity_verification.rejected? && @identity_verification.rejection_reason.present? %>
            <div class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3">
              <p class="text-sm font-medium text-red-700">
                Raison du refus :
              </p>

              <p class="mt-1 text-sm text-red-700">
                <%= @identity_verification.rejection_reason %>
              </p>
            </div>
          <% end %>
        </div>

        <!-- DOCUMENTS -->
        <div class="space-y-4">
          <h2 class="text-xl font-bold text-gray-900">
            Documents envoyés
          </h2>

          <% if @identity_verification.identity_documents.any? %>
            <% @identity_verification.identity_documents.includes(:identity_document_type).each do |document| %>
              <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">

                <p class="text-sm font-medium text-gray-500">
                  Type de document
                </p>

                <p class="mt-1 font-semibold text-gray-900">
                  <%= document.identity_document_type.translated_name %>
                </p>

                <div class="mt-4 grid gap-4 md:grid-cols-2">
                  <div>
                    <p class="text-sm font-medium text-gray-500">
                      Fichier recto
                    </p>

                    <p class="mt-1 text-sm text-gray-800">
                      <%= document.file_front.original_filename %>
                    </p>
                  </div>

                  <% if document.file_back.present? %>
                    <div>
                      <p class="text-sm font-medium text-gray-500">
                        Fichier verso
                      </p>

                      <p class="mt-1 text-sm text-gray-800">
                        <%= document.file_back.original_filename %>
                      </p>
                    </div>
                  <% end %>
                </div>

                <div class="mt-4">
                  <p class="text-sm font-medium text-gray-500">
                    Expire le
                  </p>

                  <p class="mt-1 text-sm text-gray-800">
                    <%= document.expires_at %>
                  </p>
                </div>

              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-gray-600">
              Aucun document n'a encore été envoyé.
            </p>
          <% end %>
        </div>

        <% unless @identity_verification.approved? %>
          <div class="mt-8">
            <%= link_to "Envoyer un autre document",
                new_identity_verification_path,
                class: "
                  inline-flex w-full justify-center rounded-xl bg-gray-900 px-6 py-3
                  font-medium text-white transition hover:bg-gray-800
                " %>
          </div>
        <% end %>

      <% else %>

        <!-- NO VERIFICATION -->
        <div class="rounded-2xl border border-yellow-200 bg-yellow-50 p-6">
          <h2 class="text-xl font-bold text-yellow-900">
            Aucune vérification commencée
          </h2>

          <p class="mt-2 text-sm text-yellow-800">
            Vous devez envoyer un document gouvernemental valide pour vérifier votre identité.
          </p>

          <div class="mt-6">
            <%= link_to "Commencer la vérification",
                new_identity_verification_path,
                class: "
                  inline-flex w-full justify-center rounded-xl bg-gray-900 px-6 py-3
                  font-medium text-white transition hover:bg-gray-800
                " %>
          </div>
        </div>

      <% end %>

    </div>
  </div>
</div>