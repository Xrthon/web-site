<div class="mx-auto w-full px-6">
  <div class="overflow-hidden rounded-3xl bg-white shadow-xl">

    <!-- HEADER -->
    <div class="bg-gradient-to-r from-gray-900 to-gray-700 px-8 py-10">
      <h1 class="text-3xl font-bold text-white">
        Créer un compte
      </h1>

      <p class="mt-2 text-gray-300">
        Configurez vos accès.
      </p>
    </div>

    <div class="p-8">

      <% if alert = flash[:alert] %>
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
          <%= alert %>
        </div>
      <% end %>

      <% if notice = flash[:notice] %>
        <div class="mb-6 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700">
          <%= notice %>
        </div>
      <% end %>

      <%= form_with model: @user,
                    url: registration_path,
                    data: { turbo: false },
                    class: "space-y-6" do |form| %>

        <!-- USERNAME -->
        <div>

          <%= form.label :username,
              "Nom d'utilisateur",
              class: "mb-2 block text-sm font-medium text-gray-700" %>

          <%= form.text_field :username,
              required: true,
              autocomplete: "username",
              placeholder: "exemple123",
              class: "
                w-full rounded-xl px-4 py-3
                #{ @user.errors[:username].any? ?
                'border-red-500 bg-red-50' :
                'border-gray-300' }
              " %>

          <% @user.errors[:username].each do |message| %>
            <p class="mt-2 text-sm text-red-600">
              <%= message %>
            </p>
          <% end %>

        </div>

        <!-- EMAIL -->
        <div>

          <%= form.label :email,
              "Adresse courriel",
              class: "mb-2 block text-sm font-medium text-gray-700" %>

          <%= form.email_field :email,
              required: true,
              autocomplete: "email",
              placeholder: "exemple@email.com",
              class: "
                w-full rounded-xl px-4 py-3
                #{ @user.errors[:email].any? ?
                'border-red-500 bg-red-50' :
                'border-gray-300' }
              " %>

          <% @user.errors[:email].each do |message| %>
            <p class="mt-2 text-sm text-red-600">
              <%= message %>
            </p>
          <% end %>

        </div>

        <!-- PASSWORD -->
        <div>

          <%= form.label :password,
              "Mot de passe",
              class: "mb-2 block text-sm font-medium text-gray-700" %>

          <%= form.password_field :password,
              required: true,
              autocomplete: "new-password",
              placeholder: "••••••••",
              class: "
                w-full rounded-xl px-4 py-3
                #{ @user.errors[:password].any? ?
                'border-red-500 bg-red-50' :
                'border-gray-300' }
              " %>

          <% @user.errors[:password].each do |message| %>
            <p class="mt-2 text-sm text-red-600">
              <%= message %>
            </p>
          <% end %>

        </div>

        <!-- PASSWORD CONFIRMATION -->
        <div>

          <%= form.label :password_confirmation,
              "Confirmation du mot de passe",
              class: "mb-2 block text-sm font-medium text-gray-700" %>

          <%= form.password_field :password_confirmation,
              required: true,
              autocomplete: "new-password",
              placeholder: "••••••••",
              class: "w-full rounded-xl border-gray-300 px-4 py-3" %>

        </div>

        <!-- SUBMIT -->
        <div class="pt-4">

          <%= form.submit "Créer mon compte",
              class: "
                w-full rounded-xl bg-gray-900 px-6 py-3
                font-medium text-white transition
                hover:bg-gray-800
              " %>

        </div>

      <% end %>

    </div>

  </div>

</div>