<div class="mx-auto max-w-5xl">

  <div class="overflow-hidden rounded-3xl bg-white shadow-xl">

    <div class="bg-gradient-to-r from-gray-900 to-gray-700 px-8 py-10">
      <h1 class="text-3xl font-bold text-white">
        Créer un compte
      </h1>

      <p class="mt-2 text-gray-300">
        Configure ton accès et ton profil utilisateur.
      </p>
    </div>

    <div class="p-8">

      <% if alert = flash[:alert] %>
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
          <%= alert %>
        </div>
      <% end %>

      <% if notice = flash[:notice] %>
        <div class="mb-6 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700">
          <%= notice %>
        </div>
      <% end %>

      <% if @user.errors.any? %>
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-4 text-red-700">
          <p class="mb-2 font-semibold">
            Impossible de créer le compte :
          </p>

          <ul class="list-inside list-disc space-y-1 text-sm">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user,
        url: registration_path,
        class: "space-y-8" do |form| %>

        <!-- ACCOUNT SECTION -->
        <div class="rounded-2xl border border-gray-200 p-6">

          <h2 class="mb-6 text-xl font-semibold text-gray-900">
            Informations du compte
          </h2>

          <div class="grid gap-6 md:grid-cols-2">

            <div class="md:col-span-2">
              <%= form.label :email_address, "Adresse courriel", class: "form-label" %>

              <%= form.email_field :email_address,
                required: true,
                autofocus: true,
                autocomplete: "email",
                placeholder: "exemple@email.com",
                class: "form-input" %>
            </div>

            <div class="md:col-span-2">
              <%= form.label :username, "Nom d'utilisateur", class: "form-label" %>

              <%= form.text_field :username,
                required: true,
                autocomplete: "username",
                placeholder: "exemple123",
                class: "form-input" %>
            </div>

            <div>
              <%= form.label :password, "Mot de passe", class: "form-label" %>

              <%= form.password_field :password,
                required: true,
                autocomplete: "new-password",
                placeholder: "Créer un mot de passe",
                maxlength: 72,
                class: "form-input" %>
            </div>

            <div>
              <%= form.label :password_confirmation, "Confirmation", class: "form-label" %>

              <%= form.password_field :password_confirmation,
                required: true,
                autocomplete: "new-password",
                placeholder: "Confirmer le mot de passe",
                maxlength: 72,
                class: "form-input" %>
            </div>

          </div>
        </div>

        <!-- PROFILE SECTION -->
        <%= form.fields_for :user_profile do |profile_form| %>

          <div class="rounded-2xl border border-gray-200 p-6">

            <h2 class="mb-6 text-xl font-semibold text-gray-900">
              Profil utilisateur
            </h2>

            <div class="grid gap-6 md:grid-cols-2">

              <div>
                <%= profile_form.label :first_name, "Prénom", class: "form-label" %>

                <%= profile_form.text_field :first_name,
                  placeholder: "first name",
                  class: "form-input" %>
              </div>

              <div>
                <%= profile_form.label :last_name, "Nom", class: "form-label" %>

                <%= profile_form.text_field :last_name,
                  placeholder: "last name",
                  class: "form-input" %>
              </div>

              <div>
                <%= profile_form.label :display_name, "Nom affiché", class: "form-label" %>

                <%= profile_form.text_field :display_name,
                  placeholder: "exemple123",
                  class: "form-input" %>
              </div>

              <div>
                <%= profile_form.label :phone, "Téléphone", class: "form-label" %>

                <%= profile_form.text_field :phone,
                  placeholder: "(000)000-0000",
                  class: "form-input" %>
              </div>

              <div class="md:col-span-2">
                <%= profile_form.label :avatar_url, "URL de l'avatar", class: "form-label" %>

                <%= profile_form.text_field :avatar_url,
                  placeholder: "https://...",
                  class: "form-input" %>
              </div>

              <div>
                <%= profile_form.label :language, "Langue", class: "form-label" %>

                <%= profile_form.select :language,
                  [
                    ["Français", "fr"],
                    ["English", "en"]
                  ],
                  {},
                  class: "form-input" %>
              </div>

              <div>
                <%= profile_form.label :timezone, "Fuseau horaire", class: "form-label" %>

                <%= profile_form.select :timezone,
                  [
                    ["Montréal / Toronto", "America/Toronto"],
                    ["UTC", "UTC"],
                    ["Paris", "Europe/Paris"]
                  ],
                  {},
                  class: "form-input" %>
              </div>

              <div>
                <%= profile_form.label :country, "Pays", class: "form-label" %>

                <%= profile_form.text_field :country,
                  placeholder: "Canada",
                  class: "form-input" %>
              </div>

              <div>
                <%= profile_form.label :city, "Ville", class: "form-label" %>

                <%= profile_form.text_field :city,
                  placeholder: "Montréal",
                  class: "form-input" %>
              </div>

            </div>
          </div>

        <% end %>

        <!-- ACTIONS -->
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

          <%= form.submit "Créer mon compte",
            class: "btn-primary w-full sm:w-auto" %>

          <%= link_to "Déjà un compte ? Se connecter",
            new_session_path,
            class: "text-sm font-medium text-gray-600 underline hover:text-gray-900" %>

        </div>

      <% end %>

    </div>
  </div>
</div>