<div class="mx-auto w-full px-6">

  <!-- PAGE HEADER -->
  <div class="mb-8 overflow-hidden rounded-3xl bg-white shadow-xl">

    <div class="bg-gradient-to-r from-gray-900 to-gray-700 px-8 py-10">
      <h1 class="text-3xl font-bold text-white">
        Vérifications d'identité
      </h1>

      <p class="mt-2 text-gray-300">
        Consultez et gérez les vérifications des utilisateurs.
      </p>
    </div>

  </div>

  <!-- FLASH -->
  <% if alert = flash[:alert] %>
    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
      <%= alert %>
    </div>
  <% end %>

  <% if notice = flash[:notice] %>
    <div class="mb-6 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700">
      <%= notice %>
    </div>
  <% end %>

  <!-- TABLE -->
  <div class="overflow-hidden rounded-3xl bg-white shadow-xl">

    <div class="overflow-x-auto">

      <table class="min-w-full divide-y divide-gray-200">

        <!-- HEADER -->
        <thead class="bg-gray-50">

          <tr>

            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
              Utilisateur
            </th>

            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
              Courriel
            </th>

            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
              Statut
            </th>

            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
              Documents
            </th>

            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
              Créé le
            </th>

            <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">
              Actions
            </th>

          </tr>

        </thead>

        <!-- BODY -->
        <tbody class="divide-y divide-gray-100 bg-white">

          <% @identity_verifications.each do |verification| %>

            <tr class="hover:bg-gray-50">

              <!-- USER -->
              <td class="whitespace-nowrap px-6 py-4">

                <div class="font-medium text-gray-900">
                  <%= verification.user.username %>
                </div>

              </td>

              <!-- EMAIL -->
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">

                <%= verification.user.email %>

              </td>

              <!-- STATUS -->
              <td class="whitespace-nowrap px-6 py-4">

                <% status_code = verification.identity_verification_status.code %>

                <% badge_classes =
                  case status_code
                  when "approved"
                    "bg-green-100 text-green-700"
                  when "rejected"
                    "bg-red-100 text-red-700"
                  when "expired"
                    "bg-yellow-100 text-yellow-700"
                  else
                    "bg-gray-100 text-gray-700"
                  end
                %>

                <span class="rounded-full px-3 py-1 text-xs font-semibold <%= badge_classes %>">
                  <%= verification.identity_verification_status.translated_name %>
                </span>

              </td>

              <!-- DOCUMENT COUNT -->
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">

                <%= verification.identity_documents.count %>

              </td>

              <!-- CREATED -->
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">

                <%= l(verification.created_at, format: :long) %>

              </td>

              <!-- ACTIONS -->
              <td class="whitespace-nowrap px-6 py-4 text-right">

                <%= link_to "Voir",
                    admin_identity_verification_path(verification),
                    class: "
                      inline-flex items-center rounded-xl bg-gray-900
                      px-4 py-2 text-sm font-medium text-white
                      transition hover:bg-gray-800
                    " %>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

    <!-- EMPTY STATE -->
    <% if @identity_verifications.empty? %>

      <div class="px-8 py-16 text-center">

        <h2 class="text-xl font-bold text-gray-900">
          Aucune vérification
        </h2>

        <p class="mt-2 text-sm text-gray-500">
          Aucune demande de vérification n'a encore été envoyée.
        </p>

      </div>

    <% end %>

  </div>

</div>