<div class="mx-auto w-full px-6">

  <!-- HEADER -->
  <div class="mb-8 overflow-hidden rounded-3xl bg-white shadow-xl">

    <div class="bg-gradient-to-r from-gray-900 to-gray-700 px-8 py-10">

      <h1 class="text-3xl font-bold text-white">
        Vérification d'identité
      </h1>

      <p class="mt-2 text-gray-300">
        Consultez les documents et gérez la validation utilisateur.
      </p>

    </div>

  </div>

  <!-- FLASH -->
  <% if alert = flash[:alert] %>
    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
      <%= alert %>
    </div>
  <% end %>

  <% if notice = flash[:notice] %>
    <div class="mb-6 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700">
      <%= notice %>
    </div>
  <% end %>

  <!-- USER INFORMATIONS -->
  <div class="mb-8 overflow-hidden rounded-3xl bg-white shadow-xl">

    <div class="border-b border-gray-100 px-8 py-6">

      <h2 class="text-xl font-bold text-gray-900">
        Informations utilisateur
      </h2>

    </div>

    <div class="grid gap-6 px-8 py-6 md:grid-cols-2">

      <div>

        <p class="text-sm font-medium text-gray-500">
          Nom d'utilisateur
        </p>

        <p class="mt-1 font-semibold text-gray-900">
          <%= @identity_verification.user.username %>
        </p>

      </div>

      <div>

        <p class="text-sm font-medium text-gray-500">
          Adresse courriel
        </p>

        <p class="mt-1 font-semibold text-gray-900">
          <%= @identity_verification.user.email %>
        </p>

      </div>

      <div>

        <p class="text-sm font-medium text-gray-500">
          Statut
        </p>

        <% status_code = @identity_verification.identity_verification_status.code %>

        <% badge_classes =
          case status_code
          when "approved"
            "bg-green-100 text-green-700"
          when "rejected"
            "bg-red-100 text-red-700"
          when "expired"
            "bg-yellow-100 text-yellow-700"
          else
            "bg-gray-100 text-gray-700"
          end
        %>

        <span class="mt-2 inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= badge_classes %>">
          <%= @identity_verification.identity_verification_status.translated_name %>
        </span>

      </div>

      <div>

        <p class="text-sm font-medium text-gray-500">
          Créé le
        </p>

        <p class="mt-1 font-semibold text-gray-900">
          <%= l(@identity_verification.created_at, format: :long) %>
        </p>

      </div>

    </div>

  </div>

  <!-- DOCUMENTS -->
  <div class="mb-8 overflow-hidden rounded-3xl bg-white shadow-xl">

    <div class="border-b border-gray-100 px-8 py-6">

      <h2 class="text-xl font-bold text-gray-900">
        Documents soumis
      </h2>

    </div>

    <div class="space-y-6 px-8 py-6">

      <% @identity_verification.identity_documents.each do |document| %>

        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">

          <!-- DOCUMENT TYPE -->
          <div class="mb-6">

            <p class="text-sm font-medium text-gray-500">
              Type de document
            </p>

            <p class="mt-1 text-lg font-semibold text-gray-900">
              <%= document.identity_document_type.translated_name %>
            </p>

          </div>

          <!-- FILES -->
          <div class="grid gap-6 md:grid-cols-2">

            <!-- FRONT -->
            <div class="rounded-2xl border border-gray-200 bg-white p-5">

              <p class="text-sm font-medium text-gray-500">
                Recto
              </p>

              <p class="mt-2 break-all text-sm text-gray-800">
                <%= document.file_front.original_filename %>
              </p>

              <div class="mt-4">

                <%= link_to "Ouvrir",
                    admin_user_file_path(document.file_front),
                    target: "_blank",
                    rel: "noopener",
                    class: "
                    inline-flex rounded-xl bg-gray-900 px-4 py-2
                    text-sm font-medium text-white transition
                    hover:bg-gray-800
                    " %>

              </div>

            </div>

            <!-- BACK -->
            <% if document.file_back.present? %>

              <div class="rounded-2xl border border-gray-200 bg-white p-5">

                <p class="text-sm font-medium text-gray-500">
                  Verso
                </p>

                <p class="mt-2 break-all text-sm text-gray-800">
                  <%= document.file_back.original_filename %>
                </p>

                <div class="mt-4">

                 <%= link_to "Ouvrir",
                    admin_user_file_path(document.file_back),
                    target: "_blank",
                    rel: "noopener",
                    class: "
                    inline-flex rounded-xl bg-gray-900 px-4 py-2
                    text-sm font-medium text-white transition
                    hover:bg-gray-800
                    " %>

                </div>

              </div>

            <% end %>

          </div>

          <!-- EXPIRES -->
          <div class="mt-6">

            <p class="text-sm font-medium text-gray-500">
              Expiration du document
            </p>

            <p class="mt-1 text-sm text-gray-800">
              <%= l(document.expires_at) %>
            </p>

          </div>

        </div>

      <% end %>

    </div>

  </div>

  <!-- ACTIONS -->
  <% unless @identity_verification.approved? %>

    <div class="grid gap-6 md:grid-cols-2">

      <!-- APPROVE -->
      <div class="overflow-hidden rounded-3xl bg-white shadow-xl">

        <div class="border-b border-gray-100 px-8 py-6">

          <h2 class="text-xl font-bold text-green-700">
            Approuver
          </h2>

        </div>

        <div class="px-8 py-6">

          <%= button_to "Approuver la vérification",
              approve_admin_identity_verification_path(@identity_verification),
              method: :patch,
              class: "
                w-full rounded-xl bg-green-600 px-6 py-3
                font-medium text-white transition
                hover:bg-green-700
              " %>

        </div>

      </div>

      <!-- REJECT -->
      <div class="overflow-hidden rounded-3xl bg-white shadow-xl">

        <div class="border-b border-gray-100 px-8 py-6">

          <h2 class="text-xl font-bold text-red-700">
            Refuser
          </h2>

        </div>

        <div class="px-8 py-6">

          <%= form_with url: reject_admin_identity_verification_path(@identity_verification),
                        method: :patch,
                        data: { turbo: false },
                        class: "space-y-4" do |form| %>

            <div>

              <%= form.label :rejection_reason,
                  "Raison du refus",
                  class: "mb-2 block text-sm font-medium text-gray-700" %>

              <%= form.text_area :rejection_reason,
                  required: true,
                  rows: 4,
                  placeholder: "Expliquez pourquoi la vérification est refusée...",
                  class: "
                    w-full rounded-xl border-gray-300 px-4 py-3
                  " %>

            </div>

            <div>

              <%= form.submit "Refuser la vérification",
                  class: "
                    w-full rounded-xl bg-red-600 px-6 py-3
                    font-medium text-white transition
                    hover:bg-red-700
                  " %>

            </div>

          <% end %>

        </div>

      </div>

    </div>

  <% end %>

</div>