<div class="mx-auto w-full px-6">

  <div class="overflow-hidden rounded-3xl bg-white shadow-xl">

    <div class="bg-gradient-to-r from-gray-900 to-gray-700 px-8 py-10">

      <h1 class="text-3xl font-bold text-white">
        Administration
      </h1>

      <p class="mt-2 text-gray-300">
        Tableau de bord administrateur.
      </p>

    </div>

    <div class="p-8">

      <div class="grid gap-6 md:grid-cols-3">

        <!-- VERIFICATIONS -->
        <%= link_to admin_identity_verifications_path,
        class: "
        block rounded-2xl border border-gray-200
        bg-gray-50 p-6 transition
        hover:border-gray-300 hover:bg-gray-100
        " do %>

    <div class="flex items-start justify-between">

        <div>

        <p class="text-sm font-medium text-gray-500">
            Vérifications en attente
        </p>

        <p class="mt-2 text-3xl font-bold text-gray-900">
            <%= @pending_identity_verifications %>
        </p>

        </div>

        <!-- ICON -->
        <div class="flex h-10 w-10 items-center  justify-center rounded-full bg-gray-900 text-white">

        <svg xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="h-5 w-5">

            <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />

        </svg>

        </div>

    </div>

    <% end %>

      </div>

    </div>

  </div>

</div>