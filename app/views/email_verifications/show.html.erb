<div class="mx-auto max-w-3xl px-6">

  <div class="overflow-hidden rounded-3xl bg-white shadow-xl">

    <div class="bg-gradient-to-r from-gray-900 to-gray-700 px-8 py-10">
      <h1 class="text-3xl font-bold text-white">
        Vérification du courriel
      </h1>

      <p class="mt-2 text-gray-300">
        Une vérification est requise avant de compléter votre profil.
      </p>
    </div>

    <div class="p-8">

      <% if alert = flash[:alert] %>
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
          <%= alert %>
        </div>
      <% end %>

      <% if notice = flash[:notice] %>
        <div class="mb-6 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700">
          <%= notice %>
        </div>
      <% end %>

      <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">

        <h2 class="text-xl font-semibold text-gray-900">
          Vérifiez votre boîte courriel
        </h2>

        <p class="mt-3 text-gray-600">
          Nous avons envoyé un lien de vérification à :
        </p>

        <p class="mt-2 rounded-xl bg-white px-4 py-3 font-medium text-gray-900">
          <%= Current.user.email %>
        </p>

        <p class="mt-4 text-sm text-gray-500">
          Cliquez sur le lien reçu pour confirmer votre adresse courriel. Si vous ne voyez pas le message, vérifiez vos courriels indésirables.
        </p>

      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

      <%= button_to "Renvoyer le lien de vérification",
                    email_verification_path,
                    method: :post,
                    data: { turbo: false },
                    class: "rounded-xl bg-gray-900 px-6 py-3 font-medium text-white" %>
        <%= button_to "Se déconnecter",
              session_path,
              method: :delete,
              data: { turbo: false },
              class: "rounded-xl border border-gray-300 px-6 py-3 font-medium text-gray-700 transition hover:bg-gray-50" %>

      </div>

    </div>

  </div>

</div>