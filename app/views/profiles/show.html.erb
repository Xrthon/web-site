<div class="mx-auto w-full px-6">

  <div class="overflow-hidden rounded-3xl bg-white shadow-xl">

    <!-- HEADER -->
    <div class="bg-gradient-to-r from-gray-900 to-gray-700 px-8 py-10">

      <div class="flex items-center justify-between">

        <div>
          <h1 class="text-3xl font-bold text-white">
            Profil utilisateur
          </h1>

          <p class="mt-2 text-gray-300">
            Informations personnelles du compte.
          </p>
        </div>

        <%= link_to "Modifier",
            edit_profile_path,
            class: "
              rounded-xl bg-white/10 px-5 py-3
              text-sm font-medium text-white
              transition hover:bg-white/20
            " %>

      </div>

    </div>

    <div class="p-8">

      <!-- INFORMATIONS PRINCIPALES -->
      <div class="grid gap-6 md:grid-cols-2">

        <!-- DISPLAY NAME -->
        <div class="rounded-2xl border border-gray-200 p-5">

          <p class="text-sm font-medium text-gray-500">
            Nom affiché
          </p>

          <p class="mt-2 text-lg font-semibold text-gray-900">
            <%= @profile.display_name.presence || "-" %>
          </p>

        </div>

        <!-- EMAIL -->
        <div class="rounded-2xl border border-gray-200 p-5">

          <p class="text-sm font-medium text-gray-500">
            Adresse courriel
          </p>

          <p class="mt-2 text-lg font-semibold text-gray-900">
            <%= Current.user.email %>
          </p>

        </div>

        <!-- FIRST NAME -->
        <div class="rounded-2xl border border-gray-200 p-5">

          <p class="text-sm font-medium text-gray-500">
            Prénom
          </p>

          <p class="mt-2 text-lg font-semibold text-gray-900">
            <%= @profile.first_name.presence || "-" %>
          </p>

        </div>

        <!-- LAST NAME -->
        <div class="rounded-2xl border border-gray-200 p-5">

          <p class="text-sm font-medium text-gray-500">
            Nom
          </p>

          <p class="mt-2 text-lg font-semibold text-gray-900">
            <%= @profile.last_name.presence || "-" %>
          </p>

        </div>

        <!-- PHONE -->
        <div class="rounded-2xl border border-gray-200 p-5">

          <p class="text-sm font-medium text-gray-500">
            Téléphone
          </p>

          <p class="mt-2 text-lg font-semibold text-gray-900">
            <%= @profile.phone.presence || "-" %>
          </p>

        </div>

        <!-- BIRTH DATE -->
        <div class="rounded-2xl border border-gray-200 p-5">

          <p class="text-sm font-medium text-gray-500">
            Date de naissance
          </p>

          <p class="mt-2 text-lg font-semibold text-gray-900">

            <% if @profile.birth_date.present? %>
              <%= l(@profile.birth_date) %>
            <% else %>
              -
            <% end %>

          </p>

        </div>

      </div>

      <!-- ADRESSE -->
      <div class="mt-8 rounded-3xl border border-gray-200 p-8">

        <h2 class="text-xl font-semibold text-gray-900">
          Adresse
        </h2>

        <div class="mt-6 grid gap-6 md:grid-cols-2">

          <!-- COUNTRY -->
          <div>

            <p class="text-sm font-medium text-gray-500">
              Pays
            </p>

            <p class="mt-2 text-base font-medium text-gray-900">
              <%= @profile.country.presence || "-" %>
            </p>

          </div>

          <!-- CITY -->
          <div>

            <p class="text-sm font-medium text-gray-500">
              Ville
            </p>

            <p class="mt-2 text-base font-medium text-gray-900">
              <%= @profile.city.presence || "-" %>
            </p>

          </div>

          <!-- ADDRESS 1 -->
          <div class="md:col-span-2">

            <p class="text-sm font-medium text-gray-500">
              Adresse
            </p>

            <p class="mt-2 text-base font-medium text-gray-900">
              <%= @profile.address_line1.presence || "-" %>
            </p>

          </div>

          <!-- ADDRESS 2 -->
          <div class="md:col-span-2">

            <p class="text-sm font-medium text-gray-500">
              Appartement / Suite
            </p>

            <p class="mt-2 text-base font-medium text-gray-900">
              <%= @profile.address_line2.presence || "-" %>
            </p>

          </div>

          <!-- POSTAL CODE -->
          <div>

            <p class="text-sm font-medium text-gray-500">
              Code postal
            </p>

            <p class="mt-2 text-base font-medium text-gray-900">
              <%= @profile.postal_code.presence || "-" %>
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>