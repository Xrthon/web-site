<div class="mx-auto w-full px-6">

  <div class="overflow-hidden rounded-3xl bg-white shadow-xl">

    <div class="bg-gradient-to-r from-gray-900 to-gray-700 px-8 py-10">
      <h1 class="text-3xl font-bold text-white">
        Modifier votre profil
      </h1>

      <p class="mt-2 text-gray-300">
        Mettez à jour vos informations personnelles.
      </p>
    </div>

    <div class="p-8">

      <% if @profile.errors.any? %>
        <div class="mb-8 rounded-2xl border border-red-200 bg-red-50 p-5">
          <h2 class="font-semibold text-red-800">
            Impossible de modifier le profil
          </h2>

          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-red-700">
            <% @profile.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @profile,
                    url: profile_path,
                    method: :patch,
                    data: { turbo: false },
                    class: "space-y-10" do |form| %>

        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">
          <h2 class="mb-6 text-xl font-semibold text-gray-900">
            Informations personnelles
          </h2>

          <div class="grid gap-6 md:grid-cols-2">

            <div class="md:col-span-2">
              <%= form.label :display_name, "Nom affiché", class: "mb-2 block text-sm font-medium text-gray-700" %>
              <%= form.text_field :display_name, class: "form-input" %>
            </div>

            <div>
              <%= form.label :first_name, "Prénom", class: "mb-2 block text-sm font-medium text-gray-700" %>
              <%= form.text_field :first_name, required: true, class: "form-input" %>
            </div>

            <div>
              <%= form.label :last_name, "Nom", class: "mb-2 block text-sm font-medium text-gray-700" %>
              <%= form.text_field :last_name, required: true, class: "form-input" %>
            </div>

            <div>
              <%= form.label :phone, "Téléphone", class: "mb-2 block text-sm font-medium text-gray-700" %>
              <%= form.telephone_field :phone, class: "form-input" %>
            </div>

            <div>
              <%= form.label :birth_date, "Date de naissance", class: "mb-2 block text-sm font-medium text-gray-700" %>
              <%= form.date_field :birth_date, class: "form-input" %>
            </div>

          </div>
        </div>

        <div class="rounded-2xl border border-gray-200 p-6">
          <h2 class="mb-6 text-xl font-semibold text-gray-900">
            Adresse
          </h2>

          <div class="grid gap-6 md:grid-cols-2">

            <div>
              <%= form.label :country, "Pays", class: "mb-2 block text-sm font-medium text-gray-700" %>
              <%= form.text_field :country, class: "form-input" %>
            </div>

            <div>
              <%= form.label :city, "Ville", class: "mb-2 block text-sm font-medium text-gray-700" %>
              <%= form.text_field :city, class: "form-input" %>
            </div>

            <div class="md:col-span-2">
              <%= form.label :address_line1, "Adresse", class: "mb-2 block text-sm font-medium text-gray-700" %>
              <%= form.text_field :address_line1, class: "form-input" %>
            </div>

            <div class="md:col-span-2">
              <%= form.label :address_line2, "Appartement / Suite", class: "mb-2 block text-sm font-medium text-gray-700" %>
              <%= form.text_field :address_line2, class: "form-input" %>
            </div>

            <div>
              <%= form.label :postal_code, "Code postal", class: "mb-2 block text-sm font-medium text-gray-700" %>
              <%= form.text_field :postal_code, class: "form-input" %>
            </div>

          </div>
        </div>

        <div class="flex items-center justify-between">
          <%= link_to "Annuler",
                      profile_path,
                      class: "rounded-xl border border-gray-300 px-6 py-3 font-medium text-gray-700 hover:bg-gray-50" %>

          <%= form.submit "Enregistrer les modifications",
                          class: "rounded-xl bg-gray-900 px-6 py-3 font-medium text-white transition hover:bg-gray-800" %>
        </div>

      <% end %>

    </div>

  </div>

</div>