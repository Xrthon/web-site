<div class="mx-auto max-w-4xl">

  <div class="overflow-hidden rounded-3xl bg-white shadow-xl">

    <!-- HEADER -->
    <div class="h-40 bg-gradient-to-r <%= @profile.header_gradient %>"></div>

    <!-- CONTENT -->
    <div class="relative px-8 pb-8">

      <!-- AVATAR -->
      <div class="-mt-16 flex flex-col items-center">

        <div class="h-32 w-32 overflow-hidden rounded-3xl border-4 border-white bg-gray-200 shadow-lg">

          <% if @profile.avatar_url.present? %>
            <img
              src="<%= @profile.avatar_url %>"
              alt="Avatar"
              class="h-full w-full object-cover"
            >
          <% else %>
            <div class="flex h-full w-full items-center justify-center text-4xl font-bold text-gray-500">
              <%= @profile.first_name&.first %><%= @profile.last_name&.first %>
            </div>
          <% end %>

        </div>

        <h1 class="mt-6 text-3xl font-bold text-gray-900">
          Modifier le profil
        </h1>

        <p class="mt-2 text-sm text-gray-500">
          Personnalisez votre compte et vos préférences.
        </p>

      </div>

      <!-- FORM -->
      <%= form_with model: @profile,
        url: profile_path,
        method: :patch,
        class: "mt-10 space-y-8" do |form| %>

        <!-- PERSONAL INFO -->
        <div class="rounded-2xl border border-gray-200 p-6">

          <h2 class="mb-6 text-lg font-semibold text-gray-900">
            Informations personnelles
          </h2>

          <div class="grid gap-6 md:grid-cols-2">

            <div>
              <%= form.label :first_name,
                "Prénom",
                class: "form-label" %>

              <%= form.text_field :first_name,
                class: "form-input",
                placeholder: "John" %>
            </div>

            <div>
              <%= form.label :last_name,
                "Nom",
                class: "form-label" %>

              <%= form.text_field :last_name,
                class: "form-input",
                placeholder: "Doe" %>
            </div>

            <div class="md:col-span-2">
              <%= form.label :display_name,
                "Nom affiché",
                class: "form-label" %>

              <%= form.text_field :display_name,
                class: "form-input",
                placeholder: "@johndoe" %>
            </div>

            <div>
              <%= form.label :phone,
                "Téléphone",
                class: "form-label" %>

              <%= form.text_field :phone,
                class: "form-input",
                placeholder: "+1 123 456 7890" %>
            </div>

            <div>
              <%= form.label :avatar_url,
                "Avatar URL",
                class: "form-label" %>

              <%= form.text_field :avatar_url,
                class: "form-input",
                placeholder: "https://..." %>
            </div>

          </div>

        </div>

        <!-- LOCATION -->
        <div class="rounded-2xl border border-gray-200 p-6">

          <h2 class="mb-6 text-lg font-semibold text-gray-900">
            Localisation
          </h2>

          <div class="grid gap-6 md:grid-cols-2">

            <div>
              <%= form.label :country,
                "Pays",
                class: "form-label" %>

              <%= form.text_field :country,
                class: "form-input",
                placeholder: "Canada" %>
            </div>

            <div>
              <%= form.label :city,
                "Ville",
                class: "form-label" %>

              <%= form.text_field :city,
                class: "form-input",
                placeholder: "Montréal" %>
            </div>

            <div>
              <%= form.label :language,
                "Langue",
                class: "form-label" %>

              <%= form.select :language,
                [
                  ["Français", "fr"],
                  ["English", "en"]
                ],
                {},
                class: "form-input" %>
            </div>

            <div>
              <%= form.label :timezone,
                "Fuseau horaire",
                class: "form-label" %>

              <%= form.select :timezone,
                [
                  ["EST", "America/Toronto"],
                  ["UTC", "UTC"],
                  ["Europe/Paris", "Europe/Paris"]
                ],
                {},
                class: "form-input" %>
            </div>

          </div>

        </div>

        <!-- THEME -->
        <div class="rounded-2xl border border-gray-200 p-6">

          <h2 class="mb-6 text-lg font-semibold text-gray-900">
            Apparence
          </h2>

          <div>

            <%= form.label :theme_color,
              "Couleur du profil",
              class: "form-label" %>

            <%= form.select :theme_color,
              [
                ["Gris", "gray"],
                ["Bleu", "blue"],
                ["Rouge", "red"],
                ["Vert", "green"],
                ["Violet", "purple"],
                ["Rose", "pink"]
              ],
              {},
              class: "form-input" %>

          </div>

        </div>

        <!-- BUTTONS -->
        <div class="flex flex-col gap-4 pt-2 sm:flex-row">

          <%= form.submit "Enregistrer les modifications",
            class: "btn-primary flex-1" %>

          <%= link_to "Annuler",
            profile_path,
            class: "flex items-center justify-center rounded-xl border border-gray-300 px-6 py-3 font-medium text-gray-700 transition hover:bg-gray-100" %>

        </div>

      <% end %>

    </div>

  </div>

</div>