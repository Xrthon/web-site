<div class="mx-auto w-full px-6">
  <div class="overflow-hidden rounded-3xl bg-white shadow-xl">

    <!-- HEADER -->
    <div class="bg-gradient-to-r from-gray-900 to-gray-700 px-8 py-10">

      <h1 class="text-3xl font-bold text-white">
        Compléter votre profil
      </h1>

      <p class="mt-2 text-gray-300">
        Ces informations seront utilisées dans votre compte utilisateur.
      </p>

    </div>

    <div class="p-8">

      <% if alert = flash[:alert] %>
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
          <%= alert %>
        </div>
      <% end %>

      <% if notice = flash[:notice] %>
        <div class="mb-6 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700">
          <%= notice %>
        </div>
      <% end %>

      <%= form_with model: @profile,
                    url: profile_path,
                    data: { turbo: false },
                    class: "space-y-10" do |form| %>

        <!-- SECTION INFORMATIONS -->
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">

          <div class="mb-6">

            <h2 class="text-xl font-semibold text-gray-900">
              Informations personnelles
            </h2>

            <p class="mt-1 text-sm text-gray-500">
              Informations générales du profil utilisateur.
            </p>

          </div>

          <div class="grid gap-6 md:grid-cols-2">

            <!-- DISPLAY NAME -->
            <div class="md:col-span-2">

              <%= form.label :display_name,
                  "Nom affiché",
                  class: "mb-2 block text-sm font-medium text-gray-700" %>

              <%= form.text_field :display_name,
                  placeholder: Current.user.username,
                  class: "
                    w-full rounded-xl px-4 py-3
                    #{ @profile.errors[:display_name].any? ?
                    'border-red-500 bg-red-50' :
                    'border-gray-300' }
                  " %>

              <% @profile.errors[:display_name].each do |message| %>
                <p class="mt-2 text-sm text-red-600">
                  <%= message %>
                </p>
              <% end %>

            </div>

            <!-- FIRST NAME -->
            <div>

              <%= form.label :first_name,
                  "Prénom",
                  class: "mb-2 block text-sm font-medium text-gray-700" %>

              <%= form.text_field :first_name,
                  required: true,
                  class: "
                    w-full rounded-xl px-4 py-3
                    #{ @profile.errors[:first_name].any? ?
                    'border-red-500 bg-red-50' :
                    'border-gray-300' }
                  " %>

              <% @profile.errors[:first_name].each do |message| %>
                <p class="mt-2 text-sm text-red-600">
                  <%= message %>
                </p>
              <% end %>

            </div>

            <!-- LAST NAME -->
            <div>

              <%= form.label :last_name,
                  "Nom",
                  class: "mb-2 block text-sm font-medium text-gray-700" %>

              <%= form.text_field :last_name,
                  required: true,
                  class: "
                    w-full rounded-xl px-4 py-3
                    #{ @profile.errors[:last_name].any? ?
                    'border-red-500 bg-red-50' :
                    'border-gray-300' }
                  " %>

              <% @profile.errors[:last_name].each do |message| %>
                <p class="mt-2 text-sm text-red-600">
                  <%= message %>
                </p>
              <% end %>

            </div>

            <!-- PHONE -->
            <div>

              <%= form.label :phone,
                  "Téléphone",
                  class: "mb-2 block text-sm font-medium text-gray-700" %>

              <%= form.telephone_field :phone,
                  placeholder: "(000) 000-0000",
                  class: "
                    w-full rounded-xl px-4 py-3
                    #{ @profile.errors[:phone].any? ?
                    'border-red-500 bg-red-50' :
                    'border-gray-300' }
                  " %>

            </div>

            <!-- BIRTH DATE -->
            <div>

              <%= form.label :birth_date,
                  "Date de naissance",
                  class: "mb-2 block text-sm font-medium text-gray-700" %>

              <%= form.date_field :birth_date,
                  class: "
                    w-full rounded-xl px-4 py-3
                    #{ @profile.errors[:birth_date].any? ?
                    'border-red-500 bg-red-50' :
                    'border-gray-300' }
                  " %>

            </div>

          </div>

        </div>

        <!-- SECTION ADRESSE -->
        <div class="rounded-2xl border border-gray-200 p-6">

          <div class="mb-6">

            <h2 class="text-xl font-semibold text-gray-900">
              Adresse
            </h2>

            <p class="mt-1 text-sm text-gray-500">
              Coordonnées et emplacement.
            </p>

          </div>

          <div class="grid gap-6 md:grid-cols-2">

            <!-- COUNTRY -->
            <div>

              <%= form.label :country,
                  "Pays",
                  class: "mb-2 block text-sm font-medium text-gray-700" %>

              <%= form.text_field :country,
                  placeholder: "Canada",
                  class: "w-full rounded-xl border border-gray-300 px-4 py-3" %>

            </div>

            <!-- CITY -->
            <div>

              <%= form.label :city,
                  "Ville",
                  class: "mb-2 block text-sm font-medium text-gray-700" %>

              <%= form.text_field :city,
                  placeholder: "Québec",
                  class: "w-full rounded-xl border border-gray-300 px-4 py-3" %>

            </div>

            <!-- ADDRESS 1 -->
            <div class="md:col-span-2">

              <%= form.label :address_line1,
                  "Adresse",
                  class: "mb-2 block text-sm font-medium text-gray-700" %>

              <%= form.text_field :address_line1,
                  placeholder: "123 rue Exemple",
                  class: "w-full rounded-xl border border-gray-300 px-4 py-3" %>

            </div>

            <!-- ADDRESS 2 -->
            <div class="md:col-span-2">

              <%= form.label :address_line2,
                  "Appartement / Suite",
                  class: "mb-2 block text-sm font-medium text-gray-700" %>

              <%= form.text_field :address_line2,
                  placeholder: "Appartement 4B",
                  class: "w-full rounded-xl border border-gray-300 px-4 py-3" %>

            </div>

            <!-- POSTAL CODE -->
            <div>

              <%= form.label :postal_code,
                  "Code postal",
                  class: "mb-2 block text-sm font-medium text-gray-700" %>

              <%= form.text_field :postal_code,
                  placeholder: "G1A 1A1",
                  class: "w-full rounded-xl border border-gray-300 px-4 py-3" %>

            </div>

          </div>

        </div>

        <!-- SUBMIT -->
        <div class="flex justify-end">

          <%= form.submit "Enregistrer le profil",
              class: "
                rounded-xl bg-gray-900 px-6 py-3
                font-medium text-white transition
                hover:bg-gray-800
              " %>

        </div>

      <% end %>

    </div>

  </div>

</div>