<div class="flex items-center gap-6">

  <!-- ROLE -->
  <div class="rounded-full bg-gray-100 px-4 py-2">

    <p class="text-xs font-semibold uppercase tracking-wide text-gray-600">
      <%= Current.user.roles.first.code %>
    </p>

  </div> 
  <!-- PROFILE -->
  <%= link_to "Profil",
      profile_path,
      class: "
        text-sm font-medium text-gray-700
        transition hover:text-black
      " %>

  <!-- DOCUMENTS -->
  <%= link_to "Dossiers",
      identity_verification_path,
      class: "
        text-sm font-medium text-gray-700
        transition hover:text-black
      " %>

  <!-- LOGOUT -->
  <%= button_to "Déconnexion",
      session_path,
      method: :delete,
      class: "
        rounded-xl bg-red-500 px-4 py-2
        text-sm font-medium text-white
        transition hover:bg-red-600
      " %>

</div>