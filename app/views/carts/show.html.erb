<div class="max-w-2xl mx-auto py-10 px-4">
  <h1 class="text-4xl font-bold mb-6">
    Cart #<%= @cart.id %>
  </h1>

  <div class="bg-white shadow rounded-2xl p-6">
    <p class="mb-4">
      <strong>État:</strong>
      <%= @cart.status %>
    </p>

    <p class="mb-4">
      <strong>Créée le:</strong>
      <%= @cart.created_at.strftime("%B %d, %Y") %>
    </p>

    <%= link_to "Modifier le panier",
      edit_cart_path(@cart),
      class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg inline-block" %>
  </div>
</div>