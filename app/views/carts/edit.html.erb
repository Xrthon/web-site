<div class="max-w-2xl mx-auto py-10 px-4">
  <h1 class="text-4xl font-bold mb-8">
    Modifier le panier #<%= @cart.id %>
  </h1>

  <%= form_with model: @cart, class: "space-y-6" do |form| %>

    <div>
      <%= form.label :status, class: "block font-medium mb-2" %>

      <%= form.select :status,
        ["active", "completed", "abandoned"],
        {},
        class: "w-full rounded-lg border border-gray-300 px-4 py-2" %>
    </div>

    <div>
      <%= form.submit "Update Cart",
        class: "bg-blue-600 hover:bg-blue-500 text-white px-6 py-3 rounded-lg font-medium cursor-pointer" %>
    </div>

  <% end %>
</div>