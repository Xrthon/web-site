<div class="max-w-4xl mx-auto py-10 px-4">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-4xl font-bold">Mes paniers</h1>

    <%= link_to "New Cart",
      "#",
      class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg font-medium" %>
  </div>

  <% if @carts.any? %>
    <div class="space-y-4">
      <% @carts.each do |cart| %>
        <div class="bg-white shadow rounded-2xl p-6 border border-gray-100">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-lg font-semibold">
                Panier #<%= cart.id %>
              </p>

              <p class="text-sm text-gray-500 mt-1">
                État:
                <span class="font-medium text-gray-700">
                  <%= cart.status %>
                </span>
              </p>

              <p class="text-sm text-gray-500 mt-1">
                Créée le:
                <%= cart.created_at.strftime("%B %d, %Y") %>
              </p>
            </div>

            <div class="flex gap-3">
              <%= link_to "View",
                cart_path(cart),
                class: "bg-gray-100 hover:bg-gray-200 px-4 py-2 rounded-lg text-sm font-medium" %>

              <%= link_to "Edit",
                edit_cart_path(cart),
                class: "bg-blue-100 hover:bg-blue-200 text-blue-700 px-4 py-2 rounded-lg text-sm font-medium" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-gray-50 border border-dashed border-gray-300 rounded-2xl p-10 text-center">
      <p class="text-gray-500 text-lg">
        Il n'y a aucun panier de Créée
      </p>
    </div>
  <% end %>
</div>