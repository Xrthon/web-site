<div class="mx-auto w-full px-6 py-6">

  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">Mes besoins</h1>
      <p class="mt-1 text-sm text-slate-600">
        Liste des demandes que vous avez créées.
      </p>
    </div>

    <%= link_to "Ajouter un besoin", new_client_need_path,
      class: "rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700" %>
  </div>

  <% if @client_needs.any? %>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
      <% @client_needs.each do |client_need| %>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold text-slate-900">
                <%= client_need.title %>
              </h2>

              <p class="mt-1 text-sm text-slate-500">
                <%= client_need.domain&.translated_name || "Domaine non défini" %>
              </p>
            </div>

            <% if client_need.is_urgent? %>
              <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700">
                Urgent
              </span>
            <% end %>
          </div>

          <div class="mt-5 space-y-3 text-sm text-slate-700">
            <p>
              <span class="font-semibold text-slate-900">Lieu :</span>
              <%= client_need.city %>, <%= client_need.province %>
            </p>

            <p>
              <span class="font-semibold text-slate-900">Type :</span>
              <%= client_need.service_location_type&.translated_name || "Non défini" %>
            </p>

            <p>
              <span class="font-semibold text-slate-900">Budget :</span>
              <%= number_to_currency(client_need.budget_min) %>
              à
              <%= number_to_currency(client_need.budget_max) %>
            </p>

            <p>
              <span class="font-semibold text-slate-900">Date désirée :</span>
              <%= client_need.desired_date || "Flexible" %>
            </p>
          </div>

         <div class="mt-6 flex items-center justify-between border-t border-slate-200 pt-4">

            <%= link_to "Voir le besoin",
                    client_need_path(client_need),
                    class: "text-sm font-semibold text-blue-600 hover:text-blue-700" %>


            <%= link_to "Modifier",
                    edit_client_need_path(client_need),
                    class: "text-sm font-semibold text-slate-600 hover:text-slate-900" %>
                        
            <%= button_to "Supprimer",
                    client_need_path(client_need),
                    method: :delete,
                    data: {
                    turbo_confirm: "Êtes-vous certain de vouloir supprimer cette demande ?"
                    },
                    class: "text-sm font-semibold text-red-600 hover:text-red-700 bg-transparent border-0 p-0 cursor-pointer" %>

            
         </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
      <h2 class="text-lg font-semibold text-slate-900">
        Aucun besoin créé
      </h2>

      <p class="mt-2 text-sm text-slate-600">
        Créez votre première demande pour recevoir des propositions.
      </p>

      <%= link_to "Ajouter un besoin", new_client_need_path,
        class: "mt-6 inline-block rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700" %>
    </div>
  <% end %>
</div>
