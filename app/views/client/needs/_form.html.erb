<div class="mx-auto w-full px-6 py-6">
  <div class="min-h-[calc(100vh-3rem)] overflow-hidden rounded-3xl bg-white shadow-xl">

    <div class="border-b border-slate-200 bg-slate-50 px-8 py-6">
      <p class="text-sm font-semibold text-blue-600">Espace client</p>

    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
      <%= client_need.persisted? ? "Modifier un besoin" : "Créer un besoin" %>
    </h1>

      <p class="mt-2 text-sm text-slate-600">
        Décrivez clairement votre demande afin de recevoir des propositions adaptées.
      </p>
    </div>

    <%= form_with model: client_need, local: true do |form| %>

      <div class="grid grid-cols-1 gap-8 px-8 py-8 xl:grid-cols-3">

        <section class="xl:col-span-2 space-y-8">
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h2 class="text-lg font-semibold text-slate-900">
              Informations principales
            </h2>

            <div class="mt-6 space-y-6">
              <div>
                <%= form.label :title, "Titre du besoin", class: "block text-sm font-medium text-slate-700" %>
                <%= form.text_field :title,
                      placeholder: "Ex. Installer une prise électrique extérieure",
                      class: "mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
              </div>

              <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                <div>
                  <%= form.label :domain_id, "Domaine", class: "block text-sm font-medium text-slate-700" %>
                  <%= form.select :domain_id,
                        grouped_options_for_select(
                          @domain_categories.map do |category|
                            [
                              category.translated_name,
                              category.domains.map { |domain| [domain.translated_name, domain.id] }
                            ]
                          end,
                          client_need.domain_id
                        ),
                        { prompt: "Choisir un domaine" },
                        class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
                </div>

                <div>
                  <%= form.label :service_location_type_id, "Lieu du service", class: "block text-sm font-medium text-slate-700" %>
                  <%= form.collection_select :service_location_type_id,
                        @service_location_types,
                        :id,
                        :translated_name,
                        { prompt: "Choisir un type de service" },
                        { class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" } %>
                </div>
              </div>
            </div>
          </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-900">
          Pièce requise
        </h2>

        <p class="mt-1 text-sm text-slate-600">
          Décrivez la pièce ou la tâche demandée.
        </p>

        <%= form.fields_for :client_need_items do |item_form| %>
          <%= item_form.hidden_field :id %>

          <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">

            <div>
              <%= item_form.label :title, "Nom", class: "block text-sm font-medium text-slate-700" %>

              <%= item_form.text_field :title,
                    placeholder: "Ampoule",
                    class: "mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3" %>
            </div>

            <div>
              <%= item_form.label :quantity, "Quantité", class: "block text-sm font-medium text-slate-700" %>

              <%= item_form.number_field :quantity,
                    min: 1,
                    class: "mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3" %>
            </div>

          </div>

          <div class="mt-6">
            <%= item_form.label :description, "Description", class: "block text-sm font-medium text-slate-700" %>

            <%= item_form.text_area :description,
                  rows: 4,
                  placeholder: "Ex. ampoule DEL blanche 60W",
                  class: "mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3" %>
          </div>

        <% end %>
      </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h2 class="text-lg font-semibold text-slate-900">
              Localisation
            </h2>

            <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
              <div>
                <%= form.label :city, "Ville", class: "block text-sm font-medium text-slate-700" %>
                <%= form.text_field :city,
                      placeholder: "Montréal",
                      class: "mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
              </div>

              <div>
                <%= form.label :province, "Province", class: "block text-sm font-medium text-slate-700" %>
                <%= form.text_field :province,
                      placeholder: "Québec",
                      class: "mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
              </div>

              <div>
                <%= form.label :postal_code, "Code postal", class: "block text-sm font-medium text-slate-700" %>
                <%= form.text_field :postal_code,
                      placeholder: "H1A 1A1",
                      class: "mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
              </div>
            </div>
          </div>
        </section>

        <aside class="space-y-8">
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h2 class="text-lg font-semibold text-slate-900">
              Budget et échéance
            </h2>

            <div class="mt-6 space-y-6">
              <div>
                <%= form.label :budget_min, "Budget minimum", class: "block text-sm font-medium text-slate-700" %>
                <%= form.number_field :budget_min,
                      step: 0.01,
                      placeholder: "0.00",
                      class: "mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
              </div>

              <div>
                <%= form.label :budget_max, "Budget maximum", class: "block text-sm font-medium text-slate-700" %>
                <%= form.number_field :budget_max,
                      step: 0.01,
                      placeholder: "500.00",
                      class: "mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
              </div>

              <div>
                <%= form.label :desired_date, "Date désirée", class: "block text-sm font-medium text-slate-700" %>
                <%= form.date_field :desired_date,
                      class: "mt-2 block w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6">
            <div class="flex items-start gap-3">
              <%= form.check_box :is_urgent,
                    class: "mt-1 h-4 w-4 rounded border-amber-300 text-blue-600 focus:ring-blue-500" %>

              <div>
                <%= form.label :is_urgent, "Ce besoin est urgent", class: "font-semibold text-slate-900" %>
                <p class="mt-1 text-sm text-slate-600">
                  À utiliser seulement si le service doit être traité rapidement.
                </p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <div class="flex flex-col gap-3">
             <%= form.submit(
              client_need.persisted? ? "Enregistrer les modifications" : "Créer le besoin",
              class: "w-full rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-100 cursor-pointer"
            ) %>
              <%= link_to "Annuler", client_needs_path,
                    class: "w-full rounded-xl border border-slate-300 bg-white px-6 py-3 text-center text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" %>
            </div>
          </div>
        </aside>

      </div>

    <% end %>

  </div>
</div>